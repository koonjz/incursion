# ==============================================================================
# ACM Resolve — Production Environment Variables Template (.env.production)
#
# INSTRUCTIONS:
# 1. Configure these variables in the Vercel Dashboard:
#    Project Settings > Environment Variables
# 2. Assign scopes carefully (Production vs. Preview vs. Development).
# 3. NEVER commit real production credentials to Git or store them unencrypted.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Neon Serverless PostgreSQL)
# ------------------------------------------------------------------------------
# POOLED connection string (port 6543 / -pooler host) used by PrismaClient at runtime.
# Scope: Production, Preview
DATABASE_URL="postgresql://acm_app:[STRONG_PASSWORD]@ep-[PROJECT_NAME]-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"

# DIRECT connection string (port 5432 / non-pooler host) used by schema migrations (prisma migrate deploy).
# Scope: Production (and CI secrets)
DIRECT_URL="postgresql://neondb_owner:[STRONG_PASSWORD]@ep-[PROJECT_NAME].ap-southeast-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# ------------------------------------------------------------------------------
# 2. NEXTAUTH.JS & SESSION SECURITY
# ------------------------------------------------------------------------------
# Canonical public HTTPS URL of your deployment (NO trailing slash!).
# Scope: Production (https://your-domain.org), Preview (https://preview.your-domain.org or omit for Vercel auto-detection)
NEXTAUTH_URL="https://acm-resolve.your-domain.edu"

# High-entropy cryptographic key for JWT and session signing.
# Generate via: `openssl rand -base64 32` (Must be at least 32 characters)
# Scope: Production, Preview, Development
NEXTAUTH_SECRET="REPLACE_WITH_MINIMUM_32_CHAR_BASE64_RANDOM_SECRET"

# ------------------------------------------------------------------------------
# 3. GOOGLE OAUTH 2.0 CREDENTIALS
# ------------------------------------------------------------------------------
# GCP Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# Authorized Redirect URI must match: ${NEXTAUTH_URL}/api/auth/callback/google
# Scope: Production, Preview
GOOGLE_CLIENT_ID="[PROJECT_NUMBER]-[RANDOM_HASH].apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-[RANDOM_CLIENT_SECRET_HASH]"

# ------------------------------------------------------------------------------
# 4. DOMAIN RESTRICTION & ROLE-BASED ACCESS CONTROL (RBAC)
# ------------------------------------------------------------------------------
# Strict email domain enforcement (e.g., college domain). Only accounts ending with
# this domain can authenticate. Set to your institution's Google Workspace domain.
# Scope: Production, Preview
ALLOWED_EMAIL_DOMAIN="yourcollege.edu"

# Comma-separated list of emails auto-promoted to ADMIN role on initial sign-in.
# Scope: Production, Preview
INITIAL_ADMIN_EMAILS="admin@yourcollege.edu,faculty.lead@yourcollege.edu"

# ------------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL (Resend)
# ------------------------------------------------------------------------------
# API Key from Resend (https://resend.com) with verified domain sending.
# Scope: Production, Preview
RESEND_API_KEY="re_[SAMPLE_PRODUCTION_KEY]"

# Verified sender address matching your custom domain DNS records.
# Scope: Production, Preview
EMAIL_FROM="ACM Resolve <notifications@acm-resolve.yourcollege.edu>"

# ------------------------------------------------------------------------------
# 6. OBJECT STORAGE (Receipts & Event Attachments: Cloudinary or AWS S3)
# ------------------------------------------------------------------------------
# Active storage provider: 'cloudinary' | 's3' | 'mock'
STORAGE_PROVIDER="cloudinary"

# Cloudinary credentials (if STORAGE_PROVIDER=cloudinary):
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# AWS S3 credentials (if STORAGE_PROVIDER=s3):
AWS_S3_BUCKET="acm-resolve-prod-receipts"
AWS_REGION="ap-southeast-1"
AWS_ACCESS_KEY_ID="AKIAIOSFODNN7EXAMPLE"
AWS_SECRET_ACCESS_KEY="wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"

# ------------------------------------------------------------------------------
# 7. VERCEL DEPLOYMENT METRICS & TRACING (Injected automatically by Vercel)
# ------------------------------------------------------------------------------
# NODE_ENV="production"
# VERCEL_GIT_COMMIT_SHA="[Injected by Vercel]"
