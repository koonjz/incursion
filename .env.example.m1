# ==============================================================================
# ACM Resolve — Environment Configuration Template (Milestone 1)
# Copy this file to `.env` (or `.env.local`) and populate with your local values.
# NEVER commit `.env` or real production secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Connections (PostgreSQL via Neon / Supabase)
# ------------------------------------------------------------------------------
# Connection string with connection pooling enabled (used by PrismaClient at runtime)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# Direct unpooled connection string (required for migrations: `prisma migrate dev` / `deploy`)
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. NextAuth.js Configuration
# ------------------------------------------------------------------------------
# Canonical URL of your application (localhost for local dev, Vercel URL for production)
NEXTAUTH_URL="http://localhost:3000"

# High-entropy secret key for JWT session encryption (generate with `openssl rand -base64 32`)
NEXTAUTH_SECRET="generate-a-32-byte-base64-random-secret-key-here"

# ------------------------------------------------------------------------------
# 3. Google OAuth 2.0 Credentials
# ------------------------------------------------------------------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-google-client-secret"

# ------------------------------------------------------------------------------
# 4. College Domain & Initial RBAC Bootstrap
# ------------------------------------------------------------------------------
# College email domain strictly enforced at login (e.g. 'university.edu').
# Set to '*' only in sandbox test environments if non-domain testing is needed.
ALLOWED_EMAIL_DOMAIN="university.edu"

# Comma-separated list of emails automatically granted the ADMIN role upon first sign-in
INITIAL_ADMIN_EMAILS="admin@university.edu,dean.events@university.edu"

# ------------------------------------------------------------------------------
# 5. Email & Notifications (Resend / SMTP)
# ------------------------------------------------------------------------------
RESEND_API_KEY="re_sample_123456789"
EMAIL_FROM="ACM Resolve <notifications@university.edu>"

# Optional SMTP fallback:
SMTP_HOST="smtp.university.edu"
SMTP_PORT="587"
SMTP_USER="smtp_user"
SMTP_PASSWORD="smtp_password"

# ------------------------------------------------------------------------------
# 6. Object Storage (Receipts & Event Flyers: Cloudinary or AWS S3)
# ------------------------------------------------------------------------------
# Active provider: 'cloudinary' | 's3' | 'mock'
STORAGE_PROVIDER="cloudinary"

# Cloudinary parameters:
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# AWS S3 parameters (if STORAGE_PROVIDER=s3):
AWS_S3_BUCKET="acm-resolve-receipts-bucket"
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="AKIAIOSFODNN7EXAMPLE"
AWS_SECRET_ACCESS_KEY="wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"

# ------------------------------------------------------------------------------
# 7. Testing & CI Mocking Flags
# ------------------------------------------------------------------------------
# Set to 'true' only in test / Playwright execution to bypass OAuth prompts
E2E_AUTH="false"
ALLOW_HEADER_AUTH="false"
